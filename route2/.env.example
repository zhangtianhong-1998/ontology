# Copy to .env. Mock mode does not require credentials.
ONTOLOGY_LLM_MODEL=
ONTOLOGY_LLM_BASE_URL=
ONTOLOGY_LLM_API_KEY=

# Optional overrides: non-empty environment values override YAML.
# Leave blank to use llm.stream and llm.thinking from the selected config.
# true / false (streaming SSE or ordinary JSON)
ONTOLOGY_LLM_STREAM=
# disabled / enabled / provider_default
ONTOLOGY_LLM_THINKING_MODE=
# chat_template_kwargs / enable_thinking / thinking / reasoning_effort
ONTOLOGY_LLM_THINKING_PARAMETER=
# Used only with enabled + reasoning_effort: minimal / low / medium / high / xhigh
ONTOLOGY_LLM_REASONING_EFFORT=

# Local embedding model for external-ontology cards and accepted-core retrieval. The model files
# are supplied by the user; no model download is performed at build time.
# Set this to the copied model directory on the offline computer, for example
# C:/models/Qwen3-Embedding-0.6B on Windows.
# Optional true/false override for embedding.enabled; blank uses YAML.
ONTOLOGY_EMBEDDING_ENABLED=
ONTOLOGY_EMBEDDING_MODEL_PATH=./models/Qwen3-Embedding-0.6B

# Example for Qwen on vLLM: STREAM=true, THINKING_MODE=disabled,
# THINKING_PARAMETER=chat_template_kwargs. Use your endpoint's supported control.
# For Volcengine DeepSeek V4 Flash, use THINKING_MODE=disabled and
# THINKING_PARAMETER=thinking (sends thinking.type=disabled).
# Provider support is required; hiding reasoning text does not disable thinking.
